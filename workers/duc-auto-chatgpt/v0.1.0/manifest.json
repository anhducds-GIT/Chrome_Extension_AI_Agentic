{
  "manifest_version": 3,
  "name": "Duc Auto ChatGPT",
  "version": "0.1.0",
  "description": "Personal, local-only text batch automation for ChatGPT.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Duc Auto ChatGPT"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
