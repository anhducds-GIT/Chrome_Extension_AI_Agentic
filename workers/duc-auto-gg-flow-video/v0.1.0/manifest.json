{
  "manifest_version": 3,
  "name": "Duc Auto GG Flow Video",
  "version": "0.1.0",
  "description": "Personal, local-only XLSX video generation runner for Google Flow (bootstrap).",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "sidePanel", "tabs", "downloads", "alarms"],
  "host_permissions": [
    "https://labs.google/fx/tools/flow/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Duc Auto GG Flow Video",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": ["provider-adapter.js", "image-evidence-core.js", "attempt-identity-core.js", "reconciliation-core.js", "chat-readiness-core.js", "content-decision-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
