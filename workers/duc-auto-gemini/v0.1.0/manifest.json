{
  "manifest_version": 3,
  "name": "Duc Auto Gemini",
  "version": "0.1.0",
  "description": "Personal, local-only XLSX image generation runner for Gemini Images.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "downloads"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Duc Auto Gemini",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["provider-core.js", "runtime-core.js", "run-core.js", "content-decision-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
