#!/bin/sh
# CỬA INDEX — chặn KHUNG-59: một cây làm việc có ĐÚNG MỘT index, nên `git commit` của lane này
# cuốn trọn thứ lane kia vừa `git add`. Xảy ra HAI LẦN ngày 10/09, hai chiều, hai lane.
#
# VÌ SAO Ở `commit-msg` CHỨ KHÔNG `pre-commit`: cửa cần biết AI đang commit, và câu trả lời duy
# nhất máy đọc được là nhãn `Lane:` trong lời nhắn — chỉ `commit-msg` mới thấy lời nhắn.
#
# HOOK KHÔNG ĐỌC NHÃN. Nó chuyển nguyên FILE lời nhắn cho `claim.mjs`, và bên đó dùng
# `laneFromMessage` — bộ đọc mà cổng đóng phiên và `safe-push` đang dùng. Vòng audit 10/09 bắt
# đúng chỗ này: bản đầu tôi tự viết một bộ đọc thứ hai bằng `sed`, và nó đọc `lane:` chữ thường
# trong khi `laneFromMessage` chỉ nhận `Lane:` — hai bộ đọc trên cùng một lời nhắn trả HAI TÊN
# khác nhau, tức một lượt commit lọt cửa dưới tên này rồi được cổng quy cho tên kia.
#
# ĐO 10/09: git đặt `GIT_INDEX_FILE` sang index TẠM cho cả `commit --only` và `commit -a`, nên
# `git diff --cached` trong hook thấy ĐÚNG mẻ sắp vào commit. Hook thoát khác 0 thì commit bị
# huỷ và index còn nguyên.
set -e
goc=$(git rev-parse --show-toplevel) || exit 0
exec node "$goc/scripts/claim.mjs" --cua-index --goc "$goc" --loi-nhan "$1"
