# Local browser and Codex transfer caches.
.playwright-cli/
.tmp.driveupload/
.tmp.drivedownload/

# Excel lock/temp files created while a workbook is open — never real data.
~$*.xlsx
~$*.xls

# One-off local exports and legacy ad-hoc Pilot workbooks.
_to_delete_audit_head_export_tmp/
# 12 file trong pilots/v0-trial/ ĐÃ được git theo dõi từ 18/08 (bản nền đã nghiệm thu) —
# .gitignore không có tác dụng với file đã theo dõi, nên dòng dưới chỉ chặn file MỚI thả vào
# thư mục đó. Đừng đọc nó thành "thư mục này không nằm trong repo": nó nằm.
pilots/v0-trial/

# Pilot 03 keeps only its reproducible inputs in Git (workbook, references, README).
workers/duc-auto-chatgpt/v0.1.0/pilot-03/Duc-Auto-ChatGPT-Pilot-03-Fixture.zip
workers/duc-auto-chatgpt/v0.1.0/pilot-03/Duc-Auto-ChatGPT-Pilot-03-result*.xlsx
workers/duc-auto-chatgpt/v0.1.0/pilot-03/P03-A*.png
workers/duc-auto-chatgpt/v0.1.0/pilot-03/run-*.jsonl

# Pilot 08 run packages, rendered evidence, and per-run tool caches are local outputs.
workers/duc-auto-chatgpt/v0.1.0/Pilot-08/outputs/

# `nul` — RÁC WINDOWS, không bao giờ là dữ liệu thật.
# Git Bash trên Windows KHÔNG có thiết bị `/dev/null` hay `nul`, nên một lệnh kiểu
# `node script.mjs /dev/null` hay `... > nul` sẽ tạo ra một FILE THẬT tên `nul` chứa nguyên
# phần output tưởng là đã bỏ đi. Đo thật 02/09: 19KB HTML trùng lặp nằm ở gốc repo suốt hai
# giờ, và chỉ lộ ra khi phép kiểm "khai vào Bản đồ file" được vá để soi cả file gốc.
# Bỏ qua ở đây thay vì xoá: xoá file cần Đức duyệt, còn cái này thì mọi phiên sẽ còn tạo lại.
nul

# bản ra của trang bộ khung — để publish, không commit
*.template-overview.html

# Bản ra của ba cửa vào bảng trạng thái (bang-trang-thai/). Sinh lại là ra y hệt, và
# tiến trình nền ghi vào đó liên tục — commit thì mọi phiên khác thấy cây làm việc bẩn.
bang-trang-thai/BANG.html
bang-trang-thai/trang-thai.json
bang-trang-thai/DUNG.txt

# Dau xac nhan suite — cua MAY NAY, khong di theo repo (scripts/chay-test.mjs)
.ark-suite-stamp.json

# Nhật ký chuỗi reasoning. Mặc định cũ của `chuoi-reasoning.mjs` là thư mục hiện
# hành, nên một lượt chạy từ gốc repo đẻ ra `chuoi-<nhãn>/` ngay trong cây làm
# việc — đã xảy ra 10/09 với `chuoi-ark-luat/`. Mặc định nay là
# `~/Documents/chuoi-gpt/<nhãn>`; dòng này chặn nốt các lượt chạy cũ.
/chuoi-*/

# BẢNG SỐNG — trang trạng thái chạy tại máy, sinh lại mỗi lượt. Ba file này là
# TRẠNG THÁI CỦA MỘT MÁY, không phải của repo: commit chúng là mọi phiên khác
# thấy cây làm việc bẩn và không ai biết vì sao. `bang-trang-thai/BANG.html` đã
# có dòng riêng từ trước; ba dòng này là phần bị bỏ quên ở lượt migrate bộ khung.
bang-song/BANG.html
bang-song/trang-thai.json
bang-song/DUNG.txt
